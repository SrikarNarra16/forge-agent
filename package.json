{
  "name": "forge-agent",
  "displayName": "Forge",
  "description": "Forge: VS Code agent on TrueForge",
  "version": "0.0.1",
  "publisher": "forge-local",
  "license": "MIT",
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/SrikarNarra16/forge-agent.git"
  },
  "engines": {
    "vscode": "^1.95.0"
  },
  "categories": [
    "AI",
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "forge",
          "title": "Forge",
          "icon": "media/forge.svg"
        }
      ]
    },
    "views": {
      "forge": [
        {
          "id": "forge.agentView",
          "name": "Agent",
          "type": "webview"
        }
      ]
    },
    "commands": [
      {
        "command": "forge.inlineEdit",
        "title": "Forge: Edit Selection\u2026"
      },
      {
        "command": "forge.openAgent",
        "title": "Forge: Open Agent"
      },
      {
        "command": "forge.stop",
        "title": "Forge: Stop"
      },
      {
        "command": "forge.undoLastRun",
        "title": "Forge: Undo Last Agent Run"
      },
      {
        "command": "forge.switchModel",
        "title": "Forge: Switch Model"
      },
      {
        "command": "forge.smokeTest",
        "title": "Forge: Smoke Test"
      },
      {
        "command": "forge.smokeTestCode",
        "title": "Forge: Smoke Test (code question)"
      },
      {
        "command": "forge.debugApprovalCard",
        "title": "Forge: Show Test Approval Card"
      },
      {
        "command": "forge.reviewAcceptAll",
        "title": "Forge: Accept All Hunks",
        "icon": "$(check-all)"
      },
      {
        "command": "forge.reviewRejectAll",
        "title": "Forge: Reject All Hunks",
        "icon": "$(close-all)"
      },
      {
        "command": "forge.reviewAcceptHunk",
        "title": "Forge: Accept Hunk"
      },
      {
        "command": "forge.reviewRejectHunk",
        "title": "Forge: Reject Hunk"
      },
      {
        "command": "forge.reviewApply",
        "title": "Forge: Apply Accepted Hunks",
        "icon": "$(arrow-right)"
      },
      {
        "command": "forge.reviewPickHunk",
        "title": "Forge: Review Hunks\u2026"
      },
      {
        "command": "forge.fakeProposal",
        "title": "Forge: Fake Proposal"
      }
    ],
    "keybindings": [
      {
        "command": "forge.inlineEdit",
        "key": "ctrl+alt+k",
        "mac": "cmd+alt+k",
        "when": "editorHasSelection"
      },
      {
        "command": "forge.reviewApply",
        "key": "ctrl+enter",
        "mac": "cmd+enter",
        "when": "resourceScheme == 'forge-proposal' && editorTextFocus"
      },
      {
        "command": "forge.reviewRejectAll",
        "key": "escape",
        "when": "resourceScheme == 'forge-proposal' && editorTextFocus && !suggestWidgetVisible && !findWidgetVisible && !inSnippetMode && !parameterHintsVisible"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "command": "forge.inlineEdit",
          "when": "editorHasSelection",
          "group": "navigation@100"
        }
      ],
      "commandPalette": [
        {
          "command": "forge.reviewAcceptAll",
          "when": "false"
        },
        {
          "command": "forge.reviewRejectAll",
          "when": "false"
        },
        {
          "command": "forge.reviewAcceptHunk",
          "when": "false"
        },
        {
          "command": "forge.reviewRejectHunk",
          "when": "false"
        },
        {
          "command": "forge.reviewApply",
          "when": "resourceScheme == 'forge-proposal'"
        },
        {
          "command": "forge.reviewPickHunk",
          "when": "resourceScheme == 'forge-proposal'"
        }
      ],
      "editor/title": [
        {
          "command": "forge.reviewAcceptAll",
          "when": "resourceScheme == 'forge-proposal'",
          "group": "navigation@1"
        },
        {
          "command": "forge.reviewRejectAll",
          "when": "resourceScheme == 'forge-proposal'",
          "group": "navigation@2"
        },
        {
          "command": "forge.reviewApply",
          "when": "resourceScheme == 'forge-proposal'",
          "group": "navigation@3"
        }
      ]
    },
    "configuration": {
      "title": "Forge",
      "properties": {
        "forge.trueforge.baseUrl": {
          "type": "string",
          "default": "http://localhost:8790",
          "description": "Base URL of the local TrueForge server."
        },
        "forge.models": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            "deepseek/flash",
            "groq/gpt-oss-120b"
          ],
          "description": "TrueForge model names (provider/model). Order = fallback chain: the first is primary."
        },
        "forge.contextBudgetTokens": {
          "type": "number",
          "default": 6000,
          "description": "Token budget for automatically injected context."
        },
        "forge.rollbackOnCancel": {
          "type": "boolean",
          "default": true,
          "description": "Roll back edits applied during a run when the run is cancelled."
        }
      }
    },
    "configurationDefaults": {
      "diffEditor.codeLens": true
    }
  },
  "scripts": {
    "build": "node esbuild.mjs",
    "watch": "node esbuild.mjs --watch",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit -p . && tsc --noEmit -p src/ui/webview",
    "test": "vitest run",
    "package": "vsce package --no-dependencies",
    "vscode:prepublish": "npm run build",
    "tf:start": "bash trueforge/start.sh",
    "tf:setup": "tsx scripts/tf-setup.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@truefoundry/trueforge-sdk": "^0.182.0",
    "diff": "^9.0.0",
    "ignore": "^7.0.14",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^20.19.0",
    "@types/vscode": "~1.95.0",
    "@vscode/vsce": "^4.1.0",
    "esbuild": "^0.28.2",
    "eslint": "^10.14.0",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^4.1.12"
  }
}
