{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "lib": [
      "ES2022"
    ],
    "types": [
      "node",
      "vscode"
    ],
    "rootDir": "."
  },
  "include": [
    "src/**/*.ts",
    "scripts/**/*.ts",
    "test/**/*.ts",
    "e2e/**/*.ts",
    "esbuild.mjs",
    "vitest.config.mts"
  ],
  "exclude": [
    "src/ui/webview",
    "node_modules",
    "dist"
  ]
}
