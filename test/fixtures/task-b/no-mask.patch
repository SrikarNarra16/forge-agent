+def test_config_command_masks_sensitive_keys(runner):
+    app = Flask("configapp")
+    app.config.update(SECRET_KEY="s", DB_PASSWORD="p", api_token="t", PLAIN="ok")
+    script_info = ScriptInfo(create_app=lambda: app)
+    result = runner.invoke(cli, ["config"], obj=script_info)
+    assert result.exit_code == 0
+    data = json.loads(result.output)
+    assert data["SECRET_KEY"] == "***"
+    assert data["DB_PASSWORD"] == "***"
+    assert data["api_token"] == "***"
+    assert data["PLAIN"] == "ok"
