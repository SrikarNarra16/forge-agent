+_SENSITIVE_CONFIG_PARTS = ("SECRET", "PASSWORD", "TOKEN", "KEY")
+
+
+@click.command("config", short_help="Show the app config as JSON.")
+@with_appcontext
+def config_command() -> None:
+    """Print the app config as JSON. Values of keys containing SECRET,
+    PASSWORD, TOKEN or KEY (any case) are replaced by ``***``.
+    """
+    data = dict(current_app.config)
+    click.echo(json.dumps(data, indent=2, default=str))
+
